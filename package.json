{
  "name": "cubelyo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3107",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3107",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "levels:validate": "tsx scripts/validate-levels.ts",
    "levels:freeze": "tsx scripts/freeze-levels.ts",
    "levels:previews": "tsx scripts/build-tangled-previews.ts",
    "levels:campaign": "tsx scripts/build-campaign.ts",
    "levels:reference": "tsx scripts/build-reference-level.ts",
    "test:e2e": "playwright test",
    "legal:generate": "tsx scripts/generate-legal.ts",
    "prebuild": "npm run legal:generate",
    "android:sync": "node scripts/build-android.mjs",
    "android:open": "cap open android",
    "firebase:emulators": "firebase emulators:start --project demo-cubelyo --only auth,firestore",
    "test:firebase": "firebase emulators:exec --project demo-cubelyo --only auth,firestore \"npm run test:firebase:run\"",
    "test:firebase:run": "vitest run --config vitest.firebase.config.ts && playwright test --config playwright.firebase.config.ts",
    "android:apk": "node scripts/build-android.mjs --apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@react-three/fiber": "9.8.2",
    "firebase": "^13.2.0",
    "geist": "1.9.1",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@next/env": "^16.4.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "firebase-tools": "^15.35.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
