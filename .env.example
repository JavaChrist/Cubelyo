# Configuration locale : copier en .env.local (jamais versionné).
# Mode local complet tant que cette option reste false.
NEXT_PUBLIC_FIREBASE_ENABLED=false
# Configuration Web fournie par Firebase > Paramètres du projet > Vos applications.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Réservé aux émulateurs locaux ; projet demo-* obligatoire si true.
NEXT_PUBLIC_FIREBASE_EMULATORS=false
# Aucune clé Admin, clé privée, signature Android ou secret store sous NEXT_PUBLIC_.
# Vercel : recopier ces variables dans Settings > Environment Variables, puis redéployer.
# Les variables NEXT_PUBLIC_* sont publiques et figées à la compilation.

# Facultatif : URL réelle du site pour les documents légaux. Vercel utilise VERCEL_URL si vide.
NEXT_PUBLIC_APP_URL=
