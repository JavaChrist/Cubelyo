rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    // Prototype saves are not a wallet or a proof of purchase. All other collections are denied.
    match /players/{uid}/saves/prototype {
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['schema', 'profile', 'revision', 'updatedAt'])
          && d.keys().hasOnly(['schema', 'profile', 'revision', 'updatedAt'])
          && d.schema == 1 && d.profile is string && d.profile.size() <= 250000
          && d.revision is int && d.revision > 0 && d.revision <= 1000000000
          && d.updatedAt == request.time;
      }
      allow get, delete: if owner(uid);
      allow create: if owner(uid) && valid() && request.resource.data.revision == 1;
      allow update: if owner(uid) && valid() && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
